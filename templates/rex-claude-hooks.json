{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status idle", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status working", "timeout": 5 }] }],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status blocked question", "timeout": 5 }] }
    ],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status blocked permission", "timeout": 5 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status working", "timeout": 5 }] }],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status blocked permission", "timeout": 5 }] },
      { "matcher": "elicitation_dialog", "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status blocked question", "timeout": 5 }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status done", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"$DECK_HOME\"/bin/deck-rex-status clear", "timeout": 5 }] }]
  }
}
