#!/usr/bin/env bash
# deck-trust: trust a folder once, so agents never stop at a folder-trust
# dialog there.
#
#   deck-trust <project> [--harness claude|codex|grok|pi] open the agent; the user answers its dialog
#   deck-trust <project> --grant [--yes] [--harness <h>] write the harness's trust record, on the user's yes
#   deck-trust --all [--grant [--yes]] [--harness <h>]   every registered project the harness doesn't trust yet
#   deck-trust --path <dir> [--grant] [--harness <h>]    a folder by path (--grant: only a registered project's)
#   add --check to report only and change nothing
#
# Claude, Codex and Grok all key folder trust on the repository's main checkout,
# so trusting a project once covers every worker worktree made from it.
# Pi (~/.pi/agent/trust.json) keys trust by path, the closest saved decision
# winning, so its trust doesn't reach worktrees under ~/.deck/worktrees. deck
# uses Pi only as the operator for now, where that doesn't matter.
#
# Without --grant, deck opens the agent in that folder and the user answers
# the dialog themselves:
#   - inside Herdr: in a focused workspace labelled trust-<name>, closed afterwards
#   - outside Herdr (./setup): in this terminal; the user quits the agent after
#
# --grant writes the harness's own trust record for a registered project's main
# checkout, and only on the user's explicit word: it asks "Trust ...? [y/N]"
# on the terminal for each project, or takes --yes when the user runs it
# themselves (e.g. `! bin/deck-trust <project> --grant --yes` in Claude Code).
# It refuses with no terminal and no --yes. It never changes a record the
# harness already holds for that path (such as an "untrusted" decision), backs
# the file up to <file>.deck-bak before writing, and reads the trust back after.
. "$(dirname "$0")/deck-lib.sh"

[ $# -gt 0 ] || { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

name="" path="" harness="" check=0 grant=0 yes=0 all=0
while [ $# -gt 0 ]; do
  case $1 in
    --path) path=$2; shift 2 ;;
    --harness) harness=$2; shift 2 ;;
    --check) check=1; shift ;;
    --grant) grant=1; shift ;;
    --yes) yes=1; shift ;;
    --all) all=1; shift ;;
    -*) die "unknown option: $1" ;;
    *) name=$1; shift ;;
  esac
done
[ -n "$harness" ] || harness=$(default_harness)
valid_operator_harness "$harness" || die "unsupported harness: $harness"
# What to suggest for an untrusted project: the grant where deck can write it.
fix_flag=--grant
[ "$harness" = grok ] && fix_flag=""
[ $check = 1 ] && [ $grant = 1 ] && die "--check and --grant don't mix"
[ $yes = 1 ] && [ $grant = 0 ] && die "--yes only goes with --grant"
if [ $all = 1 ]; then
  [ -z "$name" ] && [ -z "$path" ] || die "--all takes no project or --path"
fi

# ---------------------------------------------------------------- grant helpers

# The registered project whose checkout is <path>, if any.
project_at() { # <path>
  local f
  for f in "$DECK_PROJECTS"/*.conf; do
    [ -f "$f" ] || continue
    [ "$(conf_get "$f" path)" = "$1" ] && { conf_get "$f" name; return 0; }
  done
  return 1
}

# Is <path> a repository's main checkout (its top level, not a linked worktree)?
main_checkout() { # <path>
  local top gd common
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  top=$(cd "$top" && pwd -P) gd=$(cd "$gd" && pwd -P) common=$(cd "$common" && pwd -P)
  [ "$top" = "$1" ] && [ "$gd" = "$common" ]
}

store_file() {
  case $harness in
    claude) printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" ;;
    codex) printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/config.toml" ;;
    grok) printf '%s\n' "${GROK_HOME:-$HOME/.grok}/trusted_folders.toml" ;;
    pi) printf '%s\n' "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/trust.json" ;;
  esac
}

# Why <path> can't be granted for this harness; empty output means it can.
grant_refusal() { # <path>
  local p=$1 f
  f=$(store_file)
  case $p in *'"'*|*\\*|*"'"*) echo "its path has a quote or backslash, which deck won't write into $harness's config"; return ;; esac
  case $harness in
    claude)
      [ -f "$f" ] || { echo "$f doesn't exist yet: run claude once first"; return; }
      jq -e 'type == "object" and ((.projects // {}) | type == "object")' "$f" >/dev/null 2>&1 ||
        { echo "$f isn't the JSON deck expects; leaving it alone"; return; } ;;
    codex)
      [ -d "$(dirname "$f")" ] || { echo "$(dirname "$f") doesn't exist yet: run codex once first"; return; }
      if [ -f "$f" ] && grep -qF -e "\"$p\"" -e "'$p'" "$f"; then
        echo "$f already has an entry for $p that isn't \"trusted\"; edit it yourself if you want it trusted"; return
      fi ;;
    pi)
      [ -d "$(dirname "$f")" ] || { echo "$(dirname "$f") doesn't exist yet: run pi once first"; return; }
      if [ -f "$f" ]; then
        jq -e 'type == "object"' "$f" >/dev/null 2>&1 || { echo "$f isn't the JSON deck expects; leaving it alone"; return; }
        if jq -e --arg p "$p" 'has($p)' "$f" >/dev/null 2>&1; then
          echo "$f already has a decision for $p that isn't trusted; change it yourself (/trust in pi) if you want it trusted"; return
        fi
      fi ;;
    grok)
      echo "deck doesn't know Grok's trusted_folders.toml format well enough to write it; use the dialog instead (bin/deck-trust without --grant)" ;;
  esac
}

consent() { # <name> <path>
  local r
  [ $yes = 1 ] && return 0
  printf 'Trust %s (%s) for %s? [y/N] ' "$1" "$2" "$harness" >/dev/tty
  read -r r </dev/tty || r=""
  case $r in y|Y|yes|Yes) return 0 ;; esac
  return 1
}

backed_up=""
backup() { # <file>, once per run
  case " $backed_up " in *" $1 "*) return 0 ;; esac
  cp -p "$1" "$1.deck-bak" || return 1
  backed_up="$backed_up $1"
}

fingerprint() { cksum <"$1"; }

# Swap <tmp> in for <file>, unless something else wrote <file> since <before>.
swap_in() { # <file> <tmp> <before>
  if [ "$(fingerprint "$1")" != "$3" ]; then
    rm -f "$2"; warn "$1 changed while deck was writing it; nothing written, try again"; return 1
  fi
  mv "$2" "$1"
}

write_claude() { # <path>
  local p=$1 f tmp before
  f=$(store_file)
  before=$(fingerprint "$f")
  backup "$f" || return 1
  tmp=$(mktemp "$f.deck.XXXXXX") || return 1
  cp -p "$f" "$tmp"
  jq --arg p "$p" '.projects = ((.projects // {}) | .[$p] = ((.[$p] // {}) + {hasTrustDialogAccepted: true}))' "$f" >"$tmp" ||
    { rm -f "$tmp"; return 1; }
  # Only that one key may differ.
  jq -n -e --arg p "$p" --slurpfile a "$f" --slurpfile b "$tmp" '
    def strip: if .projects[$p] then .projects[$p] |= del(.hasTrustDialogAccepted) else . end
               | if .projects[$p] == {} then del(.projects[$p]) else . end
               | if .projects == {} then del(.projects) else . end;
    ($a[0] | strip) == ($b[0] | strip) and $b[0].projects[$p].hasTrustDialogAccepted == true' >/dev/null ||
    { rm -f "$tmp"; warn "the new $f would change more than one key; nothing written"; return 1; }
  swap_in "$f" "$tmp" "$before"
}

write_codex() { # <path>
  local p=$1 f tmp before
  f=$(store_file)
  [ -f "$f" ] || { : >"$f"; chmod 600 "$f"; }
  before=$(fingerprint "$f")
  backup "$f" || return 1
  tmp=$(mktemp "$f.deck.XXXXXX") || return 1
  cp -p "$f" "$tmp"
  { [ ! -s "$tmp" ] || [ -z "$(tail -c1 "$tmp")" ] || echo
    [ ! -s "$tmp" ] || echo
    printf '[projects."%s"]\ntrust_level = "trusted"\n' "$p"
  } >>"$tmp"
  swap_in "$f" "$tmp" "$before"
}

write_pi() { # <path>
  local p=$1 f tmp before
  f=$(store_file)
  [ -f "$f" ] || { echo '{}' >"$f"; chmod 600 "$f"; }
  before=$(fingerprint "$f")
  backup "$f" || return 1
  tmp=$(mktemp "$f.deck.XXXXXX") || return 1
  cp -p "$f" "$tmp"
  jq --arg p "$p" '.[$p] = true' "$f" >"$tmp" || { rm -f "$tmp"; return 1; }
  # Only that one key may differ.
  jq -n -e --arg p "$p" --slurpfile a "$f" --slurpfile b "$tmp" '($a[0] | del(.[$p])) == ($b[0] | del(.[$p])) and $b[0][$p] == true' >/dev/null ||
    { rm -f "$tmp"; warn "the new $f would change more than one key; nothing written"; return 1; }
  swap_in "$f" "$tmp" "$before"
}

# Grant one project. 0 granted or already trusted, 1 refused/failed, 2 declined.
grant_one() { # <name> <path>
  local n=$1 p=$2 why
  if harness_trusts "$harness" "$p"; then echo "$n is trusted by $harness"; return 0; fi
  main_checkout "$p" || { warn "$n: $p is not a repository's main checkout; refusing"; return 1; }
  why=$(grant_refusal "$p")
  [ -z "$why" ] || { warn "$n: not granting: $why"; return 1; }
  consent "$n" "$p" || { echo "$n: not trusted (you said no)"; return 2; }
  case $harness in
    claude) write_claude "$p" ;;
    codex) write_codex "$p" ;;
    pi) write_pi "$p" ;;
  esac || { warn "$n: writing $(store_file) failed"; return 1; }
  if harness_trusts "$harness" "$p"; then
    echo "$n is trusted by $harness (wrote $(store_file); backup at $(store_file).deck-bak)"; return 0
  fi
  warn "$n: wrote $(store_file) but $harness still doesn't read it as trusted; restore from $(store_file).deck-bak"
  return 1
}

need_consent_channel() {
  [ $yes = 1 ] && return 0
  if [ -t 0 ] && { : </dev/tty; } 2>/dev/null; then return 0; fi
  die "--grant needs the user's yes: run it yourself in a terminal, or with --yes (in Claude Code: ! bin/deck-trust ... --grant --yes)"
}

# ---------------------------------------------------------------- --all

if [ $all = 1 ]; then
  [ $grant = 1 ] && { need jq; need git; need_consent_channel; }
  rc=0 any=0
  for f in "$DECK_PROJECTS"/*.conf; do
    [ -f "$f" ] || continue
    n=$(conf_get "$f" name) p=$(conf_get "$f" path)
    harness_trusts "$harness" "$p" && continue
    any=1
    if [ $check = 1 ]; then echo "$n is NOT trusted by $harness (run: bin/deck-trust $n ${fix_flag:+$fix_flag }--harness $harness)"; rc=1
    elif [ $grant = 1 ]; then grant_one "$n" "$p" || rc=1
    else "$0" "$n" --harness "$harness" || rc=1; fi
  done
  [ $any = 1 ] || echo "every registered project is trusted by $harness"
  exit $rc
fi

# ---------------------------------------------------------------- one folder

if [ -n "$path" ]; then
  [ -d "$path" ] || die "no such folder: $path"
  path=$(cd "$path" && pwd -P)
  if [ -z "$name" ]; then name=$(project_at "$path") || name=$(basename "$path" | tr 'A-Z_.' 'a-z--'); fi
else
  require_project "$name"
  path=$(project_get "$name" path)
fi

if [ $grant = 1 ]; then
  need jq; need git
  [ "$(project_at "$path" || true)" = "$name" ] || die "$path is not a registered project's checkout; --grant only trusts registered projects"
  if ! harness_trusts "$harness" "$path"; then need_consent_channel; fi
  grant_one "$name" "$path"; rc=$?
  [ $rc = 2 ] && rc=1
  exit $rc
fi

if harness_trusts "$harness" "$path"; then echo "$name is trusted by $harness"; exit 0; fi
if [ $check = 1 ]; then
  if [ "$(project_at "$path" || true)" = "$name" ]; then hint="bin/deck-trust $name ${fix_flag:+$fix_flag }--harness $harness"; else hint="bin/deck-trust --path $path --harness $harness"; fi
  echo "$name is NOT trusted by $harness (run: $hint)"; exit 1
fi
command -v "$harness" >/dev/null 2>&1 || die "$harness is not installed"

quit_hint() {
  case $harness in
    claude) echo "type /exit" ;;
    codex) echo "type /quit" ;;
    grok) echo "type /exit" ;;
    pi) echo "type /quit" ;;
  esac
}

# Outside Herdr: run the agent right here in the foreground.
if [ "${HERDR_ENV:-}" != 1 ]; then
  echo
  echo "  $harness will open in $path and ask whether you trust this folder."
  echo "  Choose the option that trusts it, then quit $harness ($(quit_hint))."
  echo
  printf '  Press Enter to open %s... ' "$harness"
  read -r _ </dev/tty
  (cd "$path" && "$harness") </dev/tty >/dev/tty 2>&1
  if harness_trusts "$harness" "$path"; then echo "$name is trusted by $harness"; exit 0; fi
  echo "$name is still not trusted by $harness"; exit 1
fi

# Inside Herdr: a focused workspace of its own.
need herdr; need jq
label="trust-$name"
agent=$(printf 'trust-%s' "$name" | cut -c1-32)
out=$(herdr workspace create --cwd "$path" --label "$label" --focus 2>&1) || die "herdr workspace create failed: $out"
ws=$(printf '%s' "$out" | jq -r '.result.workspace.workspace_id')
pane=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id')

close_ws() {
  local l
  l=$(herdr workspace list 2>/dev/null | jq -r --arg w "$ws" '.result.workspaces[] | select(.workspace_id == $w) | .label' 2>/dev/null)
  [ "$l" = "$label" ] && herdr workspace close "$ws" >/dev/null 2>&1
}

# The new shell may still be starting; retry until its prompt is up.
tries=0 code=""
while :; do
  out=$(herdr agent start "$agent" --kind "$harness" --pane "$pane" --timeout 20000 2>&1) && { close_ws; echo "$name is trusted by $harness"; exit 0; }
  code=$(printf '%s' "$out" | jq -r '.error.code // empty' 2>/dev/null)
  [ "$code" = agent_pane_busy ] && [ $tries -lt 30 ] && { tries=$((tries + 1)); sleep 1; continue; }
  break
done
[ "$code" = agent_not_ready ] || { close_ws; die "could not start $harness: $out"; }

echo "ACTION FOR THE USER: switch to the Herdr workspace '$label' and answer $harness's trust dialog for $path."
echo "waiting up to 5 minutes..."

# An agent that becomes ready means they trusted it; one that disappears means they declined.
i=0
while [ $i -lt 300 ]; do
  st=$(herdr agent get "$agent" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null)
  case $st in
    idle|"done") herdr agent send-keys "$agent" ctrl+c >/dev/null 2>&1; sleep 1
                 herdr agent send-keys "$agent" ctrl+c >/dev/null 2>&1; sleep 1
                 close_ws; echo "$name is trusted by $harness"; exit 0 ;;
    "") close_ws; echo "$name was not trusted ($harness exited: the user declined)"; exit 1 ;;
  esac
  sleep 1; i=$((i + 1))
done
echo "still waiting on the trust dialog in workspace '$label'; run bin/deck-trust $name --check later"
exit 1
