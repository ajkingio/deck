#!/usr/bin/env bash
# fixer-allow: let a Claude Code Fixer run fixer's routine scripts without a
# permission prompt each time. The CLIENT runs this, not the Fixer:
#
#   ! bin/fixer-allow            (in Claude Code, the ! prefix runs it as you)
#   bin/fixer-allow --remove     take the rules back out
#
# Writes .claude/settings.local.json, which is private to this clone and never
# committed. Left out on purpose, so they always ask: fixer-open (pushing and
# opening PRs/MRs), fixer-land (merging),
# fixer-teardown (it can discard work), fixer-project add (it clones),
# fixer-trust (--grant writes the harness's trust config), and fixer-allow
# itself. Never add a rule here that matches fixer-trust.
. "$(dirname "$0")/fixer-lib.sh"
need jq

f="$FIXER_ROOT/.claude/settings.local.json"
rules='[
  "Bash(bin/fixer-start)",
  "Bash(bin/fixer-doctor:*)",
  "Bash(bin/fixer-sitrep:*)",
  "Bash(bin/fixer-project list)",
  "Bash(bin/fixer-project show:*)",
  "Bash(bin/fixer-job:*)",
  "Bash(bin/fixer-spawn:*)",
  "Bash(bin/fixer-tell:*)",
  "Bash(bin/fixer-wait:*)",
  "Bash(herdr agent get:*)",
  "Bash(herdr agent list:*)",
  "Bash(herdr agent read:*)",
  "Bash(herdr workspace list:*)"
]'

mkdir -p "$(dirname "$f")"
[ -s "$f" ] || echo '{}' >"$f"
jq -e . "$f" >/dev/null 2>&1 || die "$f is not valid JSON; fix it by hand first"

tmp=$(mktemp "$f.XXXXXX")
if [ "${1:-}" = --remove ]; then
  jq --argjson r "$rules" '.permissions.allow = ((.permissions.allow // []) - $r)' "$f" >"$tmp"
  msg="removed fixer's rules from"
else
  jq --argjson r "$rules" '.permissions.allow = (((.permissions.allow // []) + $r) | unique)' "$f" >"$tmp"
  msg="added fixer's rules to"
fi
mv "$tmp" "$f"
echo "$msg $f"
echo "Still asks every time: fixer-open, fixer-land, fixer-teardown, fixer-project add, fixer-trust (including --grant)."
