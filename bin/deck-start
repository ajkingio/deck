#!/usr/bin/env bash
# deck-start: everything the operator needs at session start, in one read.
# Run exactly once at the start of every session.
. "$(dirname "$0")/deck-lib.sh"

echo "# DECK SESSION START $(now)"

if [ ! -f "$DECK_CONF" ]; then
  echo
  echo "## SETUP REQUIRED"
  echo "This clone hasn't been set up. Tell the user, in one or two plain sentences, to quit this"
  echo "session and run ./setup in a normal terminal from $DECK_ROOT; it checks their machine,"
  echo "sets up folder trust, and installs the launcher alias (jackin). Do nothing else until then."
  exit 0
fi

if [ "$(conf_get "$DECK_CONF" onboarded no)" != yes ]; then
  echo
  echo "## FIRST RUN"
  echo "Setup is done but this is the first session. Load the onboarding skill after reading the rest."
fi

echo
echo "## Config"
cat "$DECK_CONF"

echo
echo "## Persona (voice for chat only)"
cat "$DECK_ROOT/persona.md"

echo
echo "## User profile"
if [ -s "$DECK_DATA/profile.md" ]; then cat "$DECK_DATA/profile.md"; else echo "(empty)"; fi

echo
echo "## Operator engrams"
n=0
if [ -d "$DECK_DATA/engrams" ]; then
  for f in "$DECK_DATA/engrams"/*.md; do
    [ -f "$f" ] || continue
    # "fixer" is the operator audience's name from before the rename.
    case $(fm_get "$f" audience) in operator|fixer|both) ;; *) continue ;; esac
    printf -- '- [%s] %s\n' "$(fm_get "$f" scope)" "$(fm_body "$f" | sed '/^[[:space:]]*$/d' | tr '\n' ' ')"
    n=$((n + 1))
  done
fi
[ $n = 0 ] && echo "(none)"

if [ -f "$(project_conf fixer)" ] && [ ! -f "$(project_conf deck)" ]; then
  echo
  echo "## NOTE"
  echo "deck is registered under its old project name, fixer. Tell the user to run bin/deck-migrate in a"
  echo "normal terminal; until then, use project name fixer for changes to deck's own code."
elif [ ! -f "$(project_conf deck)" ]; then
  echo
  echo "## NOTE"
  echo "deck itself isn't registered as a project yet. Register it before changing deck's code:"
  echo "  bin/deck-project add $DECK_ROOT --name deck --mode local"
fi

echo
echo "## Projects"
"$DECK_BIN/deck-project" list

"$DECK_BIN/deck-sitrep"

echo
echo "## Doctor"
"$DECK_BIN/deck-doctor" --brief || true
echo "(only problems are listed)"
