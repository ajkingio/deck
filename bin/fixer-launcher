#!/usr/bin/env bash
# fixer-launcher: manage the shell alias that starts fixer (`holocall`).
#
#   fixer-launcher install   write the alias (replaces this clone's old one)
#   fixer-launcher remove    take this clone's alias out
#   fixer-launcher show      print the alias, rc file and opening line
#   fixer-launcher status    exit 0 if this clone's alias is installed, 1 if not
#   fixer-launcher conflicts print other definitions of the alias in the shell config
#
# The alias name is FIXER_ALIAS in bin/fixer-lib.sh. It runs bin/fixer-launch. The block in the rc file is fenced with
# markers naming this clone's path, so several clones never clobber each other.
# Supports zsh (~/.zshrc), bash (~/.bashrc) and fish (conf.d/fixer-<hash>.fish).
. "$(dirname "$0")/fixer-lib.sh"

alias_name=$FIXER_ALIAS
launch="$FIXER_BIN/fixer-launch"
tag="fixer ($FIXER_ROOT)"
hash=$(printf '%s' "$FIXER_ROOT" | cksum | cut -d' ' -f1)

shell_name=$(basename "${SHELL:-zsh}")
case $shell_name in
  zsh) rc="${ZDOTDIR:-$HOME}/.zshrc" ;;
  bash) rc="$HOME/.bashrc" ;;
  fish) rc="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/fixer-$hash.fish" ;;
  *) die "unsupported shell '$shell_name'; add this yourself: alias $alias_name='$launch'" ;;
esac

outside_block() { # <file>: print the file without this clone's block
  awk -v b="# >>> $tag >>>" -v e="# <<< $tag <<<" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip' "$1"
}

strip_block() { # remove this clone's block from the rc file
  [ -f "$rc" ] || return 0
  local tmp
  tmp=$(mktemp "$rc.fixer.XXXXXX")
  outside_block "$rc" >"$tmp"
  cat "$tmp" >"$rc" && rm -f "$tmp"   # keep the rc file's own permissions and links
}

is_installed() { [ -f "$rc" ] && grep -qF "# >>> $tag >>>" "$rc"; }

case ${1:-} in
install)
  # Warn about a name that already means something else in this shell.
  existing=$(command -v "$alias_name" 2>/dev/null || true)
  if [ -n "$existing" ] && [ "$existing" != "$launch" ]; then
    warn "'$alias_name' already resolves to $existing; the alias will take precedence in new shells"
  fi
  if [ "$shell_name" = fish ]; then
    mkdir -p "$(dirname "$rc")"
    printf '# >>> %s >>>\nalias %s %s\n# <<< %s <<<\n' "$tag" "$alias_name" "'$launch'" "$tag" >"$rc"
  else
    strip_block
    [ -f "$rc" ] || : >"$rc"
    # Make sure the file ends with a newline before appending.
    [ -s "$rc" ] && [ -n "$(tail -c1 "$rc")" ] && echo >>"$rc"
    printf '# >>> %s >>>\nalias %s=%s\n# <<< %s <<<\n' "$tag" "$alias_name" "'$launch'" "$tag" >>"$rc"
  fi
  echo "installed alias '$alias_name' in $rc"
  echo "open a new terminal (or run: source $rc) to use it"
  ;;
remove)
  if [ "$shell_name" = fish ]; then rm -f "$rc"; else strip_block; fi
  echo "removed fixer's alias from $rc"
  ;;
show)
  echo "alias:    $alias_name -> $launch"
  echo "rc file:  $rc"
  echo "greeting: $FIXER_GREETING"
  if is_installed; then echo "status:   installed"; else echo "status:   not installed"; fi
  ;;
status)
  is_installed
  ;;
conflicts)
  # Lines outside this clone's block that define the same name (a hand-written alias, another clone's block).
  if [ "$shell_name" = fish ]; then
    dir=$(dirname "$rc")
    files="$(dirname "$dir")/config.fish"
    for f in "$dir"/*.fish; do [ "$f" = "$rc" ] || files="$files
$f"; done
    pat="^[[:space:]]*(alias[[:space:]]+$alias_name([=[:space:]]|\$)|function[[:space:]]+$alias_name([[:space:]]|\$))"
  else
    files=$rc
    pat="^[[:space:]]*alias[[:space:]]+$alias_name="
  fi
  printf '%s\n' "$files" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    outside_block "$f" | grep -E "$pat" | while IFS= read -r l; do printf '%s: %s\n' "$f" "$l"; done
  done
  exit 0
  ;;
*)
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
