#!/usr/bin/env bash
# deck-spawn: hire a worker for a queued job.
#
#   deck-spawn <id>            create worktree + worker space, start the worker, send the brief
#   deck-spawn <id> --resume   after the user cleared a startup dialog by hand: just send the brief
#   deck-spawn <id> --relaunch [--note "<progress>"]
#                              the worker is gone (or is being replaced): start a new one in the
#                              same worktree and branch, telling it what happened so far
#
# The worker runs in the multiplexer chosen by mux= in config/deck.conf (or
# DECK_MUX), recorded in the job as mux= (see bin/deck-mux.sh):
#   herdr: git worktree add (branch deck/<id>) -> herdr workspace create ->
#          herdr agent start --kind <harness> -> herdr agent prompt "read your brief".
#          The Herdr agent name is the bare job id.
#   rex:   git worktree add -> rex window new (a tab running the harness) ->
#          wait for it to report ready -> paste "read your brief" + Return.
# Each job owns exactly one worker space (Herdr workspace or Rex tab), labelled
# "└ <id>" and moved right after the operator's own (best-effort).
#
# --relaunch refuses while a live worker still holds the job. It never touches
# the worktree or branch. Under Herdr it reuses the job's pane when that pane
# and its "└ <id>" workspace still exist; under Rex it closes the job's old tab
# (its program has exited) and opens a new one. Otherwise it creates a new
# space placed like a normal spawn. The job record changes only once the new worker is up;
# if the start fails, the record stays as it was (and a workspace created for
# the attempt is closed). If the new worker stops at a startup dialog, the job
# goes to 'starting' and --resume finishes the relaunch.
. "$(dirname "$0")/deck-lib.sh"

id=${1:-}; shift || true
require_job "$id"
resume=0 relaunch=0 note=""
while [ $# -gt 0 ]; do
  case $1 in
    --resume) resume=1; shift ;;
    --relaunch) relaunch=1; shift ;;
    --note) [ $# -ge 2 ] || die "--note needs a value"; note=$2; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
[ $resume = 1 ] && [ $relaunch = 1 ] && die "use either --resume or --relaunch, not both"
[ -z "$note" ] || [ $relaunch = 1 ] || die "--note only goes with --relaunch"

need git; need jq

dir=$(job_dir "$id")
status=$(job_get "$id" status)
harness=$(job_get "$id" harness)
valid_harness "$harness" || die "job $id's harness '$harness' can't run a worker (worker harnesses: $DECK_HARNESSES)"
wt=$(job_get "$id" worktree)
created_ws=""   # a worker space this run created; closed again if a relaunch fails

# The mux: a job keeps the one it was first spawned under.
if [ $resume = 0 ] && [ $relaunch = 0 ]; then mux=$(mux_name) || exit 1; else mux=$(job_mux "$id"); fi
mux_require_ready "$mux"
space=$(mux_space "$mux")

# Pi's launch arguments, worked out before anything is created so a refusal
# leaves nothing behind. Pi never asks before a tool runs, so there is no
# approval flag. Its trust is keyed by path (the closest saved decision wins)
# and worktrees live outside the project's checkout, so trusting the checkout
# doesn't cover them: pass --approve, which trusts project-local files for this
# run only and writes nothing to trust.json, and only when the main checkout is
# trusted. Flags are checked against `pi --help` first, since Pi changes quickly.
pi_args=()
if [ "$harness" = pi ] && command -v pi >/dev/null 2>&1; then
  pproj=$(job_get "$id" project)
  harness_trusts pi "$(project_get "$pproj" path)" ||
    die "pi doesn't trust project $pproj yet, so deck won't pass --approve for its worktree. With the user's word: bin/deck-trust $pproj --grant --harness pi"
  pihelp=$(pi --help 2>&1) || die "pi --help failed: $pihelp"
  pi_flag() { printf '%s\n' "$pihelp" | grep -Eq -- "(^|[[:space:],])$1([^[:alnum:]_-]|$)"; }
  for f in --append-system-prompt --name --approve; do
    pi_flag "$f" || die "this pi doesn't support $f (see pi --help); update it with: pi update self"
  done
  pi_args=(--append-system-prompt "$DECK_ROOT/templates/worker-system.md" --name "$id" --approve)
  # Optional model and thinking level; unset means Pi's own default.
  pmodel=$(conf_get "$DECK_CONF" pi_worker_model "")
  pthink=$(conf_get "$DECK_CONF" pi_worker_thinking "")
  if [ -n "$pmodel" ]; then
    pi_flag --model || die "pi_worker_model is set in config/deck.conf, but this pi doesn't support --model"
    pi_args+=(--model "$pmodel")
  fi
  if [ -n "$pthink" ]; then
    pi_flag --thinking || die "pi_worker_thinking is set in config/deck.conf, but this pi doesn't support --thinking"
    pi_args+=(--thinking "$pthink")
  fi
fi

# On a failed relaunch start, put things back: close the space we made and
# leave the job record untouched.
start_failed() { # <message>
  if [ $relaunch = 1 ] && [ -n "$created_ws" ]; then
    mux_ws_close "$id" "$created_ws" || warn "could not close $space $created_ws"
  fi
  die "$1"
}

if [ $relaunch = 1 ]; then
  case $status in
    queued) die "job $id has not been spawned yet; use: bin/deck-spawn $id" ;;
    landed|closed|cancelled) die "job $id is $status; there is nothing to relaunch" ;;
  esac
  command -v "$harness" >/dev/null 2>&1 || die "worker harness '$harness' is not installed"
  "$DECK_BIN/deck-trust" "$(job_get "$id" project)" --harness "$harness" --check >/dev/null ||
    die "$harness doesn't trust project $(job_get "$id" project) yet, so the worker would stop at a trust dialog. With the user's word: bin/deck-trust $(job_get "$id" project) --grant --harness $harness"
  [ -d "$wt" ] || die "worktree $wt is gone; nothing to relaunch into"
  [ "$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)" = "$(job_get "$id" branch)" ] ||
    die "worktree $wt is not on branch $(job_get "$id" branch); refusing to relaunch into it"
  if mux_agent_exists "$id"; then
    die "a live agent still owns job $id in $(mux_title "$mux"). Steer it with bin/deck-tell $id --interrupt \"<message>\", or have the user quit it in $space $(worker_ws_label "$id") first"
  fi

  # Herdr: reuse the old pane if it and its workspace are still there. Rex:
  # close the old tab (its program has exited); the start opens a new one.
  old_ws=$(job_get "$id" workspace) old_pane=$(job_get "$id" pane)
  ws="" pane=""
  if [ "$mux" = rex ]; then
    [ -z "$old_ws" ] || mux_ws_close_if_ours "$id" "$old_ws"
  elif [ -n "$old_ws" ] && [ -n "$old_pane" ] && mux_ws_reusable "$id" "$old_ws" "$old_pane"; then
    ws=$old_ws pane=$old_pane
  fi
  if [ -z "$pane" ] && [ "$mux" = herdr ]; then
    mux_ws_create "$id" "$wt" || die "herdr workspace create failed: $MUX_OUT"
    ws=$MUX_WS pane=$MUX_PANE
    created_ws=$ws
  fi
elif [ $resume = 0 ]; then
  [ "$status" = queued ] || die "job $id is $status, not queued"
  grep -qE '(DECK|FIXER):FILL' "$dir/brief.md" && die "brief still has DECK:FILL markers; fill them in first: $dir/brief.md"
  command -v "$harness" >/dev/null 2>&1 || die "worker harness '$harness' is not installed"
  "$DECK_BIN/deck-trust" "$(job_get "$id" project)" --harness "$harness" --check >/dev/null ||
    die "$harness doesn't trust project $(job_get "$id" project) yet, so the worker would stop at a trust dialog. With the user's word: bin/deck-trust $(job_get "$id" project) --grant --harness $harness"

  project=$(job_get "$id" project)
  ppath=$(project_get "$project" path)
  base=$(job_get "$id" base)
  branch=$(job_get "$id" branch)
  [ -d "$ppath" ] || die "project path missing: $ppath"
  [ -e "$wt" ] && die "worktree path already exists: $wt"

  # pr mode branches from the forge's latest base; local mode from the local
  # checkout's base, which is where deck-land merges it back.
  baseref=$base
  if [ "$(job_get "$id" mode)" = pr ] && git -C "$ppath" remote get-url origin >/dev/null 2>&1; then
    if git -C "$ppath" fetch --quiet origin "$base" 2>/dev/null; then baseref="origin/$base"; fi
  fi
  mkdir -p "$(dirname "$wt")"
  git -C "$ppath" worktree add --quiet -b "$branch" "$wt" "$baseref" || die "git worktree add failed"
  wt=$(cd "$wt" && pwd -P)
  job_set "$id" worktree "$wt"
  job_set "$id" base_sha "$(git -C "$wt" rev-parse HEAD)"

  job_set "$id" mux "$mux"
  [ "$mux" != rex ] || job_set "$id" mux_session "$(rex_session)"
  mux_ws_create "$id" "$wt" || die "herdr workspace create failed: $MUX_OUT (worktree left at $wt)"
  ws=$MUX_WS pane=$MUX_PANE
  job_set "$id" workspace "$ws"
  job_set "$id" pane "$pane"
  job_set "$id" status starting
else
  [ "$status" = starting ] || die "--resume is only for a job stuck in 'starting' (job $id is $status)"
  pane=$(job_get "$id" pane)
  ws=$(job_get "$id" workspace)
  ast=$(mux_agent_status "$id")
  if [ "${ast%% *}" = blocked ]; then
    die "worker $id is still at a dialog in $space $ws; ask the user to answer it there, then rerun with --resume"
  fi
fi

# Start the agent unless one is already in the pane (a --resume after the
# user answered a startup dialog by hand).
if ! mux_agent_exists "$id"; then
  case $harness in
    claude)
      set -- --permission-mode "$(conf_get "$DECK_CONF" claude_permission_mode auto)" \
        --add-dir "$dir" --append-system-prompt-file "$DECK_ROOT/templates/worker-system.md" -n "$id"
      # Claude Code reports its own status to Rex (OSC 7501). For a Claude Code
      # that doesn't, rex_claude_hooks=on adds hooks that report it instead.
      if [ "$mux" = rex ] && [ "$(conf_get "$DECK_CONF" rex_claude_hooks off)" = on ]; then
        set -- "$@" --settings "$DECK_ROOT/templates/rex-claude-hooks.json"
      fi ;;
    codex)
      # A linked worktree's git dir (<common>/worktrees/<name>) and its objects
      # and refs (<common>) live outside the worktree, and Codex keeps a
      # worktree's gitdir read-only even when it is an extra writable root
      # (--add-dir / writable_roots; seen on 0.167). Only a permissions profile
      # naming those paths for write lets the worker commit and fetch. Codex
      # ignores the profile if --sandbox or sandbox_mode is set anywhere.
      tq() { printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"; }
      gcommon=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir) || die "not a git worktree: $wt"
      gdir=$(git -C "$wt" rev-parse --path-format=absolute --git-dir) || die "not a git worktree: $wt"
      set -- -a never --disable hooks -c 'default_permissions="deck_worker"' \
        -c "permissions.deck_worker={extends=\":workspace\",network={enabled=true},filesystem={$(tq "$dir")=\"write\",$(tq "$gcommon")=\"write\",$(tq "$gdir")=\"write\"}}" ;;
    grok)
      set -- --always-approve ;;
    pi)
      set -- ${pi_args[@]+"${pi_args[@]}"} ;;
  esac

  # Herdr: a brand-new pane's shell may still be starting up; this waits for
  # its prompt. Rex: this opens the tab and waits for the harness to be ready.
  started=0
  mux_agent_start "$id" "$harness" "$pane" "$wt" "$@" && started=1
  if [ "$mux" = rex ] && [ -n "$MUX_PANE" ]; then
    ws=$MUX_WS pane=$MUX_PANE
    [ $relaunch = 1 ] && created_ws=$ws
    # Record the new tab once there is a worker in it (a fresh spawn: at once),
    # so the brief, --resume and teardown reach it.
    if [ $relaunch = 0 ] || [ $started = 1 ] || [ "$MUX_ERR" = agent_not_ready ]; then
      job_set "$id" workspace "$ws"; job_set "$id" pane "$pane"
    fi
  fi
  if [ $started = 0 ]; then
    if [ "$MUX_ERR" = agent_not_ready ]; then
      if [ $relaunch = 1 ]; then
        # The agent is up but at a dialog: record it so --resume can finish the relaunch.
        job_set "$id" workspace "$ws"; job_set "$id" pane "$pane"
        job_set "$id" relaunch_pending 1; job_set "$id" relaunch_note "$note"
        job_set "$id" status starting
      fi
      if [ "$mux" = rex ]; then readhint="bin/deck-peek $id"; else readhint="herdr pane read $pane --source visible --lines 40"; fi
      die "worker $id is stopped at a startup dialog in $space $ws ($(worker_ws_label "$id")). Read it with: $readhint. Ask the user to answer it there, then run: bin/deck-spawn $id --resume"
    fi
    if [ $relaunch = 1 ]; then
      if [ "$mux" = herdr ]; then what="herdr agent start failed"; else what="$harness failed to start in Rex"; fi
      start_failed "$what: $MUX_OUT. The job record is unchanged; fix the cause, then retry: bin/deck-spawn $id --relaunch"
    fi
    if [ "$mux" = herdr ]; then
      die "herdr agent start failed: $MUX_OUT. Fix the cause, then retry with: bin/deck-spawn $id --resume"
    fi
    # Rex: nothing is running in the tab; close it so a retry starts clean.
    [ -z "$ws" ] || mux_ws_close "$id" "$ws" || true
    job_set "$id" workspace ""; job_set "$id" pane ""
    die "$harness failed to start in Rex: $MUX_OUT. Fix the cause, then retry with: bin/deck-spawn $id --resume"
  fi
fi

# A relaunch (or a --resume that finishes one) gets a preamble on top of the brief.
pending=$(job_get "$id" relaunch_pending)
[ $relaunch = 1 ] && pending=1
if [ "$pending" = 1 ]; then
  [ $relaunch = 1 ] || note=$(job_get "$id" relaunch_note)
  since=$(job_get "$id" base_sha)
  [ -n "$since" ] || since=$(job_get "$id" base)
  msg="You are worker $id, hired by deck. You were relaunched: an earlier worker on this job stopped before it finished. Your worktree $wt and branch $(job_get "$id" branch) are exactly as it left them. Before anything else, run git status and git log $since..HEAD, and read $dir/status.log, to see what was already done. Then read your brief at $dir/brief.md and follow it exactly, continuing from where the work stopped."
  [ -z "$note" ] || msg="$msg
Progress note from deck: $note"
  if [ -s "$dir/messages.log" ]; then
    msg="$msg
Messages deck sent the earlier worker (oldest first):
$(tail -n 40 "$dir/messages.log")"
  fi
else
  msg="You are worker $id, hired by deck. Read your brief at $dir/brief.md and follow it exactly. Start now."
fi
mux_agent_prompt "$id" "$msg" 20000
rc=$? code=$MUX_ERR out=$MUX_OUT
# A timeout here is the good case: the worker is still working on the job.
if [ $rc -ne 0 ] && [ "$code" != timeout ]; then
  if [ $relaunch = 1 ]; then
    # The new agent is up but has no brief: record it so --resume can retry.
    job_set "$id" workspace "$ws"; job_set "$id" pane "$pane"
    job_set "$id" relaunch_pending 1; job_set "$id" relaunch_note "$note"
    job_set "$id" status starting
  fi
  die "could not hand the brief to worker $id ($code): $out. Retry with: bin/deck-spawn $id --resume"
fi

if [ "$pending" = 1 ]; then
  job_set "$id" workspace "$ws"
  job_set "$id" pane "$pane"
  # Watch only what the new worker reports; say so if the old one left
  # reports nobody had read yet.
  lines=$(wc -l <"$dir/status.log" | tr -d ' ')
  seen=$(job_get "$id" seen_lines 0)
  if [ "$lines" -gt "$seen" ]; then
    warn "unread reports from the earlier worker, now skipped:"
    tail -n "+$((seen + 1))" "$dir/status.log" >&2
  fi
  job_set "$id" seen_lines "$lines"
  job_set "$id" herdr_flag ""
  job_set "$id" relaunch_pending ""
  job_set "$id" relaunch_note ""
  job_set "$id" relaunched "$(now)"
else
  job_set "$id" started "$(now)"
fi
job_set "$id" status running
verb=spawned
[ "$pending" = 1 ] && verb=relaunched
if [ "$mux" = rex ]; then
  echo "$verb $id: harness=$harness mux=rex tab=$ws block=$pane worktree=$wt"
else
  echo "$verb $id: harness=$harness workspace=$ws pane=$pane worktree=$wt"
fi
echo "next: make sure a watcher is running (bin/deck-wait)"
