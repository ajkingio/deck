#!/usr/bin/env bash
# fixer-doctor: check that this machine can run fixer.
#
#   fixer-doctor          full report; exit 1 if anything FAILs
#   fixer-doctor --brief  only WARN and FAIL lines
. "$(dirname "$0")/fixer-lib.sh"

brief=0
[ "${1:-}" = --brief ] && brief=1
fails=0

ok() { [ $brief = 1 ] || printf 'OK    %s\n' "$*"; }
wn() { printf 'WARN  %s\n' "$*"; }
fl() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }

for t in git jq; do
  if command -v $t >/dev/null 2>&1; then ok "$t"; else fl "$t is not installed"; fi
done

if command -v herdr >/dev/null 2>&1; then
  v=$(herdr --version 2>/dev/null | awk '{print $2}')
  maj=${v%%.*}; rest=${v#*.}; min=${rest%%.*}
  if [ "${maj:-0}" -gt 0 ] || [ "${min:-0}" -ge 9 ]; then ok "herdr $v"; else fl "herdr $v is too old; fixer needs 0.9 or newer (herdr update)"; fi
else
  fl "herdr is not installed (https://herdr.dev)"
fi

if [ "${HERDR_ENV:-}" = 1 ]; then
  ok "running inside Herdr (pane ${HERDR_PANE_ID:-?})"
else
  fl "not running inside Herdr: run 'herdr' in the fixer directory, then start your agent inside it"
fi

me=$(fixer_harness)
installed=""
for h in $FIXER_HARNESSES; do command -v "$h" >/dev/null 2>&1 && installed="$installed $h"; done
if [ -n "$installed" ]; then ok "harnesses installed:$installed${me:+ (Fixer is running in $me)}"; else fl "none of claude, codex, grok is installed"; fi
rh=$(conf_get "$FIXER_CONF" runner_harness "")
if [ -n "$rh" ]; then
  if command -v "$rh" >/dev/null 2>&1; then ok "runner harness: $rh"; else fl "configured runner harness '$rh' is not installed"; fi
fi

if [ -f "$FIXER_CONF" ]; then ok "configured"; else wn "not configured yet: onboarding will run"; fi

# Forge CLIs for registered projects.
if [ -d "$FIXER_PROJECTS" ]; then
  for f in "$FIXER_PROJECTS"/*.conf; do
    [ -f "$f" ] || continue
    n=$(conf_get "$f" name); forge=$(conf_get "$f" forge); remote=$(conf_get "$f" remote)
    [ -d "$(conf_get "$f" path)" ] || { fl "project $n: path missing: $(conf_get "$f" path)"; continue; }
    host=$(printf '%s' "$remote" | sed -E 's#^[a-z+]+://##; s#^[^@]*@##; s#[:/].*$##')
    case $forge in
      github)
        if ! command -v gh >/dev/null 2>&1; then fl "project $n: gh is not installed"
        elif gh auth status --hostname "$host" >/dev/null 2>&1; then ok "project $n: gh authenticated for $host"
        else fl "project $n: gh is not logged in to $host (gh auth login --hostname $host)"; fi ;;
      gitlab)
        if ! command -v glab >/dev/null 2>&1; then fl "project $n: glab is not installed"
        elif glab auth status --hostname "$host" >/dev/null 2>&1; then ok "project $n: glab authenticated for $host"
        else fl "project $n: glab is not logged in to $host (glab auth login --hostname $host)"; fi ;;
      none) ok "project $n: local only" ;;
      *) wn "project $n: unknown forge '$forge'" ;;
    esac
    th=$(default_harness)
    if "$FIXER_BIN/fixer-trust" "$n" --harness "$th" --check >/dev/null 2>&1; then ok "project $n: trusted by $th"
    else wn "project $n: not trusted by $th yet; runners can't start there (bin/fixer-trust $n --grant --harness $th)"; fi
  done
fi

[ $fails = 0 ]
