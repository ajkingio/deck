#!/usr/bin/env bash
# deck-sitrep: one snapshot of the whole crew, for the operator to summarize.
#
#   deck-sitrep [--forge]    --forge also asks GitHub/GitLab for PR/MR state and CI
. "$(dirname "$0")/deck-lib.sh"

with_forge=0
[ "${1:-}" = --forge ] && with_forge=1

section() { printf '\n## %s\n' "$1"; }

line() { # <id>
  local id=$1 s ast="" last pr=""
  s=$(job_get "$id" status)
  if command -v herdr >/dev/null 2>&1; then
    ast=$(herdr agent get "$id" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null)
  fi
  last=$(tail -n1 "$(job_dir "$id")/status.log" 2>/dev/null | cut -d' ' -f2-)
  if [ $with_forge = 1 ] && [ "$(job_get "$id" mode)" = pr ] && [ "$s" = review ]; then
    pr=$(project_forge "$(job_get "$id" project)" -C "$(project_get "$(job_get "$id" project)" path)" status "$(job_get "$id" branch)" 2>/dev/null \
      | jq -r '"pr=\(.state) ci=\(.ci) \(.url // "")"' 2>/dev/null)
  fi
  printf -- '- %s [%s] %s/%s on %s via %s%s — %s%s%s\n' "$id" "$s" "$(job_get "$id" kind)" "$(job_get "$id" mode)" \
    "$(job_get "$id" project)" "$(job_get "$id" harness)" "${ast:+ (herdr: $ast)}" "$(job_get "$id" title)" \
    "${last:+ | last: $last}" "${pr:+ | $pr}"
}

group() { # <title> <statuses...>
  local title=$1 id s out=""; shift
  for id in $(job_ids); do
    s=$(job_get "$id" status)
    for want in "$@"; do [ "$s" = "$want" ] && out="$out$(line "$id")
"; done
  done
  section "$title"
  if [ -n "$out" ]; then printf '%s' "$out"; else echo "(none)"; fi
}

echo "# sitrep $(now)"
group "Needs the user" blocked review reported failed
group "Running" starting running
group "Queued" queued
group "Recently landed" landed

section "Watcher"
if [ -f "$DECK_STATE/wait.pid" ] && kill -0 "$(cat "$DECK_STATE/wait.pid")" 2>/dev/null; then
  echo "running (pid $(cat "$DECK_STATE/wait.pid"))"
else
  echo "not running"
fi

section "Proposals"
if [ -f "$DECK_DATA/proposals.md" ]; then
  echo "$(grep -c '\[pending\]' "$DECK_DATA/proposals.md" | tr -d ' ') pending"
else
  echo "0 pending"
fi
