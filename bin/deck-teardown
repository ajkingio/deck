#!/usr/bin/env bash
# deck-teardown: close a job's Herdr workspace and remove its worktree.
#
#   deck-teardown <id>             refuses unless the work has landed
#   deck-teardown <id> --discard   the user explicitly said to throw this work away
#
# Landed means: gig/pr -> PR/MR merged, and deck/<id> has no commits beyond the
# merged head; gig/local -> branch merged into base; recon -> report.md exists. The deck/<id> branch is deleted only when landed;
# with --discard the branch is kept as a last safety net.
. "$(dirname "$0")/deck-lib.sh"

id=${1:-}; shift || true
require_job "$id"
discard=0
[ "${1:-}" = --discard ] && discard=1

dir=$(job_dir "$id")
kind=$(job_get "$id" kind)
mode=$(job_get "$id" mode)
branch=$(job_get "$id" branch)
base=$(job_get "$id" base)
wt=$(job_get "$id" worktree)
ws=$(job_get "$id" workspace)
ppath=$(project_get "$(job_get "$id" project)" path)

landed=0
why=""
case $kind:$mode in
  recon:*) [ -s "$dir/report.md" ] && landed=1 ;;
  gig:pr)
    st=$(project_forge "$(job_get "$id" project)" -C "$ppath" status "$branch" 2>/dev/null)
    if [ "$(printf '%s' "$st" | jq -r .state 2>/dev/null)" = merged ]; then
      # The forge's "merged" covers only the head that was merged. Commits made
      # on the branch after it (never pushed) have not landed.
      head=$(printf '%s' "$st" | jq -r '.head_sha // empty' 2>/dev/null)
      if ! git -C "$ppath" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
        landed=1
      else
        for sha in "$head" "$(job_get "$id" landed_sha)"; do
          [ -n "$sha" ] || continue
          git -C "$ppath" merge-base --is-ancestor "$branch" "$sha" 2>/dev/null && { landed=1; break; }
        done
        if [ $landed = 0 ]; then
          if [ -n "$head" ] && git -C "$ppath" cat-file -e "$head^{commit}" 2>/dev/null; then
            why="the PR/MR for $branch merged at $(git -C "$ppath" rev-parse --short "$head"), but $branch has commits that were not merged:
$(git -C "$ppath" log --oneline "$head..$branch")"
          else
            why="the PR/MR for $branch merged, but its merged head (${head:-unknown}) is not in $ppath, so $branch cannot be confirmed fully merged"
          fi
        fi
      fi
    fi ;;
  gig:local)
    git -C "$ppath" merge-base --is-ancestor "$branch" "$base" 2>/dev/null && landed=1 ;;
esac

dirty=""
[ -d "$wt" ] && dirty=$(git -C "$wt" status --porcelain 2>/dev/null)

if [ $discard = 0 ]; then
  [ -z "$why" ] || die "job $id: $why
refusing. --discard would throw this away; only if the user explicitly wants that: deck-teardown $id --discard"
  [ $landed = 1 ] || die "job $id has not landed; refusing. If the user explicitly wants it thrown away: deck-teardown $id --discard"
  [ -z "$dirty" ] || die "worktree $wt has uncommitted changes; refusing"
fi

# Close only the workspace this job created, and only if it still carries our
# label: "└ <id>", or the plain "<id>" used by jobs spawned before grouping.
if [ -n "$ws" ] && command -v herdr >/dev/null 2>&1; then
  label=$(herdr workspace list 2>/dev/null | jq -r --arg w "$ws" '.result.workspaces[] | select(.workspace_id == $w) | .label' 2>/dev/null)
  if [ "$label" = "$(worker_ws_label "$id")" ] || [ "$label" = "$id" ]; then
    herdr workspace close "$ws" >/dev/null 2>&1 || warn "could not close Herdr workspace $ws"
  elif [ -n "$label" ]; then
    warn "workspace $ws is now labelled '$label', not '$(worker_ws_label "$id")'; leaving it open"
  fi
fi

if [ -d "$wt" ]; then
  if [ $discard = 1 ]; then
    git -C "$ppath" worktree remove --force "$wt" || die "could not remove worktree $wt"
  else
    git -C "$ppath" worktree remove "$wt" || die "could not remove worktree $wt"
  fi
fi
git -C "$ppath" worktree prune 2>/dev/null || true

if [ $landed = 1 ]; then
  git -C "$ppath" branch -D "$branch" >/dev/null 2>&1 || true
  job_set "$id" status closed
else
  job_set "$id" status cancelled
  echo "kept branch $branch in $ppath"
fi
echo "tore down $id"
