#!/bin/sh
# deck-rex-status: report a Claude Code worker's state to Rex over OSC 7501.
#
#   deck-rex-status <state> [kind]     state: idle|working|done|blocked|clear
#                                      kind (with blocked): permission|question|auth
#
# A Claude Code hook (templates/rex-claude-hooks.json, passed to a worker with
# --settings when config/deck.conf has rex_claude_hooks=on). Claude Code 2.1
# reports its own status to Rex, so deck leaves this off by default; it is the
# fallback for a Claude Code that doesn't.
#
# A hook has no controlling terminal, so it writes the report to the worker's
# terminal device by path: $DECK_TTY if set, else the tty of the nearest
# ancestor process that has one (Claude Code itself). Rex attributes the report
# to the terminal's foreground process (Claude Code) and drops it when that
# process exits. Format (https://www.superlogical.com/rex/docs/build/program-status):
#   ESC ] 7501 ; state=<s>[:kind=<k>]:app=claude-code ESC \
# Never fails the hook: any problem exits 0 silently. Reads and ignores stdin.
cat >/dev/null 2>&1 || true

state=${1:-}
case $state in idle|working|done|blocked|error|clear) ;; *) exit 0 ;; esac
kind=""
if [ "$state" = blocked ]; then
  case ${2:-} in permission|question|auth) kind=":kind=$2" ;; esac
fi

tty=${DECK_TTY:-}
if [ -z "$tty" ]; then
  pid=$$ n=0
  while [ "$n" -lt 8 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case $t in ""|"?"|"??") ;; *) tty=/dev/$t; break ;; esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    n=$((n + 1))
  done
fi
[ -n "$tty" ] && [ -w "$tty" ] || exit 0

if [ "$state" = clear ]; then
  printf '\033]7501;state=clear\033\\' >"$tty" 2>/dev/null
else
  printf '\033]7501;state=%s%s:app=claude-code\033\\' "$state" "$kind" >"$tty" 2>/dev/null
fi
exit 0
