#!/usr/bin/env bash
# deck-doctor: check that this machine can run deck.
#
#   deck-doctor          full report; exit 1 if anything FAILs
#   deck-doctor --brief  only WARN and FAIL lines
. "$(dirname "$0")/deck-lib.sh"

brief=0
[ "${1:-}" = --brief ] && brief=1
fails=0

ok() { [ $brief = 1 ] || printf 'OK    %s\n' "$*"; }
wn() { printf 'WARN  %s\n' "$*"; }
fl() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }

for t in git jq; do
  if command -v $t >/dev/null 2>&1; then ok "$t"; else fl "$t is not installed"; fi
done

if command -v herdr >/dev/null 2>&1; then
  v=$(herdr --version 2>/dev/null | awk '{print $2}')
  maj=${v%%.*}; rest=${v#*.}; min=${rest%%.*}
  if [ "${maj:-0}" -gt 0 ] || [ "${min:-0}" -ge 9 ]; then ok "herdr $v"; else fl "herdr $v is too old; deck needs 0.9 or newer (herdr update)"; fi
else
  fl "herdr is not installed (https://herdr.dev)"
fi

if [ "${HERDR_ENV:-}" = 1 ]; then
  ok "running inside Herdr (pane ${HERDR_PANE_ID:-?})"
else
  fl "not running inside Herdr: run 'herdr' in the deck directory, then start your agent inside it"
fi

me=$(operator_harness)
installed=""
for h in $DECK_OPERATOR_HARNESSES; do command -v "$h" >/dev/null 2>&1 && installed="$installed $h"; done
if [ -n "$installed" ]; then ok "harnesses installed:$installed${me:+ (the operator is running in $me)}"; else fl "none of claude, codex, grok, pi is installed"; fi

# Pi as the operator: deck's Pi extension loads only in a trusted folder.
# Pi as the operator or as workers: Herdr reads Pi's state exactly only with
# its Pi integration. (Per-project trust for workers is checked below.)
dh=$(cfg_get deck_harness fixer_harness "")
rh=$(cfg_get worker_harness runner_harness "")
if [ "$dh" = pi ] || [ "$me" = pi ]; then
  if command -v pi >/dev/null 2>&1; then ok "pi $(pi --version 2>/dev/null | head -n1)"
  else fl "the operator harness is pi, but pi is not installed"; fi
  if harness_trusts pi "$DECK_ROOT"; then ok "pi trusts the deck folder, so deck's Pi extension loads"
  else wn "pi doesn't trust $DECK_ROOT, so deck's Pi extension (watcher, write guard) won't load: bin/deck-trust --path $DECK_ROOT --grant --harness pi, or /trust in pi"; fi
fi
if { [ "$dh" = pi ] || [ "$me" = pi ] || [ "$rh" = pi ]; } && command -v herdr >/dev/null 2>&1; then
  line=$(herdr integration status 2>/dev/null | grep -E '^pi:' | head -n1)
  case $line in
    *current*) ok "Herdr's Pi integration is installed" ;;
    *) wn "Herdr's Pi integration isn't installed${line:+ (${line#pi: })}; Herdr will guess Pi's state from the screen: herdr integration install pi" ;;
  esac
fi
if [ -n "$rh" ]; then
  if command -v "$rh" >/dev/null 2>&1; then ok "worker harness: $rh"; else fl "configured worker harness '$rh' is not installed"; fi
fi

if [ -f "$DECK_CONF" ]; then ok "configured"; else wn "not configured yet: onboarding will run"; fi

# Forge CLIs for registered projects.
if [ -d "$DECK_PROJECTS" ]; then
  for f in "$DECK_PROJECTS"/*.conf; do
    [ -f "$f" ] || continue
    n=$(conf_get "$f" name); forge=$(conf_get "$f" forge); remote=$(conf_get "$f" remote)
    [ -d "$(conf_get "$f" path)" ] || { fl "project $n: path missing: $(conf_get "$f" path)"; continue; }
    host=$(printf '%s' "$remote" | sed -E 's#^[a-z+]+://##; s#^[^@]*@##; s#[:/].*$##')
    case $forge in
      github)
        if ! command -v gh >/dev/null 2>&1; then fl "project $n: gh is not installed"
        elif gh auth status --hostname "$host" >/dev/null 2>&1; then ok "project $n: gh authenticated for $host"
        else fl "project $n: gh is not logged in to $host (gh auth login --hostname $host)"; fi ;;
      gitlab)
        if ! command -v glab >/dev/null 2>&1; then fl "project $n: glab is not installed"
        elif glab auth status --hostname "$host" >/dev/null 2>&1; then ok "project $n: glab authenticated for $host"
        else fl "project $n: glab is not logged in to $host (glab auth login --hostname $host)"; fi ;;
      none) ok "project $n: local only" ;;
      *) wn "project $n: unknown forge '$forge'" ;;
    esac
    th=$(default_harness)
    if "$DECK_BIN/deck-trust" "$n" --harness "$th" --check >/dev/null 2>&1; then ok "project $n: trusted by $th"
    else wn "project $n: not trusted by $th yet; workers can't start there (bin/deck-trust $n --grant --harness $th)"; fi
  done
fi

[ $fails = 0 ]
